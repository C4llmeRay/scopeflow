# Copy to .env and fill in. Both are safe to ship in the app bundle:
# the anon key is a public identifier and every table is behind RLS.
# Leave the key empty to run with no backend at all (everything stays on the phone).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Which answers the AI buttons: "demo" (on-device rules, no API key needed) or
# "claude" (the `ai` Edge Function, which needs ANTHROPIC_API_KEY as a secret).
# Defaults to demo with no backend and claude with one.
EXPO_PUBLIC_AI_MODE=demo

# 1 brings back the estimating features: measured rooms, damage sheet, pricing
# and estimates. Off by default — the app is photos for Xactimate.
EXPO_PUBLIC_ESTIMATING=

# 1 keeps "Load a sample job" on the job list once a backend is configured.
EXPO_PUBLIC_DEMO_TOOLS=1

# 1 offers "email me a code" on the sign-in screen. Needs working email (custom
# SMTP on a free Supabase project). Without it, sign in with a password: create
# the account under Authentication → Users → Add user, "Auto Confirm User" on.
EXPO_PUBLIC_EMAIL_CODES=

# Crash reporting. Leave empty to run without it.
EXPO_PUBLIC_SENTRY_DSN=

# After changing anything here, restart with `npx expo start --clear` —
# Metro caches these values inside compiled files.
